# URL del Web App de Google Apps Script (endpoint que recibe el formulario)
PUBLIC_GAS_URL=https://script.google.com/macros/s/TU_WEB_APP_ID/exec

# Clave publica del sitio reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Dejar vacio para deshabilitar reCAPTCHA en desarrollo.
PUBLIC_RECAPTCHA_SITE_KEY=

# NOTA GAS (gas/config.gs):
# - RECAPTCHA_SECRET: clave secreta del sitio. Si esta vacia, la verificacion se omite.
# - REQUIRE_RECAPTCHA: false (default) acepta envios sin token (ideal para probar en local).
#   En PRODUCCION ponerlo en true para exigir token valido en todos los envios.
