---
import CampoSelect from "./CampoSelect.astro";
import { COMUNAS } from "../data/comunas.js";

interface Props {
  name: string;
  id?: string;
  required?: boolean;
  label?: string;
}

const { name, id = name, required = false, label = "Comuna" } = Astro.props;

const options = COMUNAS.map((c) => ({ value: c, label: c }));
---

<CampoSelect
  {label}
  {name}
  {id}
  {required}
  options={options}
  placeholder="Seleccione una Comuna..."
/>
