---
import InputField from "./InputField.astro";
import SelectField from "./SelectField.astro";
import RutInput from "./RutInput.astro";
import SelectorComuna from "./SelectorComuna.astro";
import SelectorEscolaridad from "./SelectorEscolaridad.astro";
import CampoCondicional from "./CampoCondicional.astro";

import {
  CURSOS,
  CURSOS_REPITENCIA,
  COLEGIOS,
  NACIONALIDADES,
  SEXO_OPTIONS,
  SI_NO,
  SAE_OPTIONS,
  VIVE_CON,
  PREVISION_OPTIONS,
} from "../data/index.js";
---

<main class="container">
  <img id="logo" src="assets/img/picture3_new2.png" />
  <h1>Ficha de Pre Matrícula - Año 2027</h1>
  <h3>Liceo San José del Carmen</h3>
  <p class="intro">
    Completa este formulario para iniciar el proceso de pre-matrícula.
    Los campos con (<span class="required">*</span>) son obligatorios.
  </p>

  <form id="formPrematricula">
    <div class="form-grid">
      <label>Selecciona un curso a prematricular:<span class="required">*</span></label>
      <select name="cursoMatricula" id="curso" required>
        <option value="" selected disabled>Seleccione un curso...</option>
        {CURSOS.map((c) => (
          <option value={c.value}>{c.label}</option>
        ))}
      </select>
    </div>

    <!-- 1. Datos del Alumno -->
    <section>
      <h2>1. Datos del Alumno</h2>
      <div class="form-grid">
        <RutInput label="RUN (Alumno)" name="rutAlumno" id="rutAlumno" required />
        <InputField label="Nombres" name="nombresAlumno" id="nombresAlumno" required placeholder="Ej. Juan Pedro" autoFormat />
        <InputField label="Apellido Paterno" name="apellidoPaterno" id="apellidoPaterno" required placeholder="Ej. Pérez" autoFormat />
        <InputField label="Apellido Materno" name="apellidoMaterno" id="apellidoMaterno" required placeholder="Ej. Rodríguez" autoFormat />
        <InputField label="Fecha de Nacimiento" name="fechaNacimiento" id="fechaNacimiento" type="date" required />
        <InputField label="Edad" name="edad" id="edad" type="number" min={1} placeholder="Se calcula automaticamente" readonly required />
        <SelectField label="Sexo" name="sexo" required options={SEXO_OPTIONS} />
        <CampoCondicional label="Nacionalidad" selectName="nacionalidad" inputName="otraNacionalidad" inputLabel="Especifique nacionalidad" inputPlaceholder="Ingrese su nacionalidad" triggerValue="Otro" options={NACIONALIDADES} required />
        <InputField label="Dirección" name="domicilio" required placeholder="Ej. Villa Nelson Cabrera, calle principal, #123" />
        <SelectorComuna name="comuna" required />
        <InputField label="Región" name="region" value="Libertador Bernardo O'Higgins" readonly required />
        <CampoCondicional label="Vive con" selectName="viveCon" inputName="otraVivecon" inputLabel="Especifique con quien vive" inputPlaceholder="Ingrese con quien vive" triggerValue="Otro" options={VIVE_CON} required />
        <CampoCondicional label="¿Pertenece a algún programa social?" selectName="programaSocial" inputName="otraProgramaSocial" inputLabel="Especifique el programa social" inputPlaceholder="Ingrese el programa social" triggerValue="Si" options={SI_NO} required />
        <CampoCondicional label="¿Pertenece a alguna etnia?" selectName="etnia" inputName="otraEtnia" inputLabel="Especifique la etnia" inputPlaceholder="Ingrese la etnia" triggerValue="Si" options={SI_NO} required />
        <SelectField label="¿Ha repetido algún curso?" name="repiteCurso" id="repiteCurso" required options={CURSOS_REPITENCIA} />
        <SelectField label="¿Opta a clase de religión?" name="claseReligion" id="claseReligion" options={SI_NO} required />
        <CampoCondicional label="Colegio de procedencia" selectName="colegioProcedencia" inputName="otroColegio" inputLabel="Especificar colegio" inputPlaceholder="Nombre del colegio" triggerValue="Otro" options={COLEGIOS} required inputRequired />
        <SelectField label="Alumno cuenta con" name="SAE" id="alumnoSae" required options={SAE_OPTIONS} placeholder="Elija una opción..." />
      </div>
    </section>

    <!-- 2. Datos del Apoderado -->
    <section>
      <h2>2. Datos del Apoderado</h2>
      <div class="form-grid">
        <RutInput label="RUN (Apoderado)" name="rutApoderado" id="rutApoderado" required />
        <InputField label="Nombre Completo" name="nombreApoderado" id="nombreApoderado" required placeholder="Ej. María Elena Vargas Pino" autoFormat />
        <InputField label="Fecha de nacimiento" name="fechaNacApoderado" type="date" required />
        <InputField label="Teléfono de contacto" name="telefonoApoderado" type="tel" required placeholder="Ej. 991234567" />
        <InputField label="Correo electrónico" name="correoApoderado" type="email" required placeholder="Ej. correo@dominio.cl" />
        <InputField label="Domicilio" name="domicilioApoderado" required placeholder="Ej. Villa Nelson Cabrera, Calle principal, #123" />
        <SelectorComuna name="comunaApoderado" required />
        <SelectorEscolaridad name="escolaridadApoderado" id="escolaridadApoderado" required />
        <InputField label="Profesión u oficio" name="profesionApoderado" id="profesionApoderado" required placeholder="Ej. Ingeniera Civil" />
      </div>
    </section>

    <!-- 3. Datos de los Padres -->
    <section>
      <h2>3. Datos de los Padres</h2>
      <div class="form-grid">
        <RutInput label="RUN del Padre" name="rutPadre" id="rutPadre" required/>
        <InputField label="Nombre del Padre" name="nombrePadre" id="nombrePadre" placeholder="Ej. Juan Ricardo Pérez Huerta" required autoFormat />
        <InputField label="Fecha de Nacimiento" name="fechaNacPadre" type="date" required />
        <InputField label="Domicilio" name="domicilioPadre" required placeholder="Ej. Av. Siempre Viva 123" />
        <SelectorComuna name="comunaPadre" id="comunaPadre" required />
        <InputField label="Profesión u Oficio" name="profesionPadre" placeholder="Ej. Trabajador Agricola" required />
        <SelectorEscolaridad name="escolaridadPadre" id="escolaridadPadre" label="Escolaridad" required />
      </div>

      <div class="form-grid">
        <RutInput label="RUN de la Madre" name="rutMadre" id="rutMadre" required />
        <InputField label="Nombre de la Madre" name="nombreMadre" id="nombreMadre" placeholder="Ej. Maria Teresa Perez Huerta" required autoFormat />
        <InputField label="Fecha de Nacimiento" name="fechaNacMadre" type="date" required/>
        <InputField label="Domicilio" name="domicilioMadre" required placeholder="Ej. Av. Siempre Viva 123" />
        <SelectorComuna name="comunaMadre" id="comunaMadre" required />
        <InputField label="Profesión u Oficio" name="profesionMadre" placeholder="Ej. Trabajadora Agricola" required />
        <SelectorEscolaridad name="escolaridadMadre" id="escolaridadMadre" label="Escolaridad" required />
      </div>
    </section>

    <!-- 4. Salud del Alumno -->
    <section>
      <h2>4. Salud del Alumno</h2>
      <div class="form-grid">
        <CampoCondicional label="¿Ha estado en tratamiento médico?" selectName="tratamientoMedico" inputName="defTratMedico" inputLabel="Especifique el tratamiento" inputPlaceholder="Ingrese el tratamiento" triggerValue="Si" options={SI_NO} required inputRequired />
        <CampoCondicional label="¿Pertenece a algún programa escolar?" selectName="programaEscolar" inputName="defProgramaEscolar" inputLabel="Especifique el programa" inputPlaceholder="Ingrese el programa" triggerValue="Si" options={SI_NO} required inputRequired />
        <SelectField label="¿Posee antecedentes de trastornos de aprendizaje u otros?" name="trast_aprendizaje" id="trast_aprendizaje" required options={SI_NO} />
        <CampoCondicional label="¿Es alérgico a medicamentos o alimentos?" selectName="alergiaMed" inputName="defAlergiaMed" inputLabel="Especifique alergia o remedio" inputPlaceholder="Especifique la alergia aqui" triggerValue="Si" options={SI_NO} required inputRequired />
        <CampoCondicional label="¿Posee contraindicación médica para actividad física?" selectName="contraMedica" inputName="defContraMedica" inputLabel="Especifique contraindicación Médica" inputPlaceholder="Especifique diagnostico aqui" triggerValue="Si" options={SI_NO} required inputRequired />
        <SelectField label="Previsión de Salud" name="prevision" id="previsionSalud" required options={PREVISION_OPTIONS} placeholder="Seleccione una opción" />
      </div>
    </section>

    <!-- 5. Transporte Escolar -->
    <section>
      <h2>5. Transporte Escolar</h2>
      <div class="form-grid">
        <CampoCondicional label="¿Necesita movilización?" selectName="movEscolar" inputName="defMovEscolar" inputLabel="Especifique Sector" inputPlaceholder="Especifique sector para movilización" triggerValue="Si" options={SI_NO} required inputRequired />
      </div>
    </section>

    <!-- 6. Apoderado Suplente -->
    <section>
      <h2>6. Apoderado Suplente</h2>
      <div class="form-grid">
        <InputField label="Nombre Completo" name="nombreSuplente" id="nombreSuplente" placeholder="Ej: Roberto Antonio Pérez Vásquez" autoFormat />
        <RutInput label="RUN" name="rutSuplente" />
        <InputField label="Parentesco" name="parentescoSuplente" placeholder="Ej: Hermano" autoFormat />
      </div>
    </section>

    <div id="errorSummary" class="error-summary" style="display: none;" role="alert"></div>

    <button type="submit">Enviar formulario</button>
  </form>
</main>

<script type="module" src="/scripts/script.js" is:inline></script>
