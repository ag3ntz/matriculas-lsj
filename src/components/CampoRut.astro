---
import CampoEntrada from "./CampoEntrada.astro";

interface Props {
  label: string;
  name: string;
  id?: string;
  required?: boolean;
  placeholder?: string;
}

const {
  label,
  name,
  id = name,
  required = false,
  placeholder = "Ej. 12.345.678-9",
} = Astro.props;
---

<CampoEntrada {label} {name} {id} {required} {placeholder} dataTipo="rut" />
