---
interface Props {
  etiqueta: string;
  nombreSelect: string;
  nombreEntrada: string;
  etiquetaEntrada: string;
  placeholderEntrada?: string;
  valorDisparador: string;
  opciones: Array<{ value: string; label: string }>;
  obligatorio?: boolean;
  entradaObligatoria?: boolean;
}

const {
  etiqueta,
  nombreSelect,
  nombreEntrada,
  etiquetaEntrada,
  placeholderEntrada = "",
  valorDisparador,
  opciones,
  obligatorio = false,
  entradaObligatoria = false,
} = Astro.props;

const contenedorId = `${nombreSelect}Contenedor`;
const entradaId = `${nombreSelect}Entrada`;
---

<div>
  <label for={nombreSelect}>
    {etiqueta}{obligatorio && <span class="required">*</span>}
  </label>
  <select
    name={nombreSelect}
    id={nombreSelect}
    required={obligatorio}
    aria-required={obligatorio || undefined}
    data-valor-disparador={valorDisparador}
  >
    <option value="" selected disabled>Seleccione una opción...</option>
    {opciones.map((o) => <option value={o.value}>{o.label}</option>)}
  </select>
  <div id={contenedorId} style="display: none; margin-top: 10px;">
    <label for={entradaId}
      >{etiquetaEntrada}{
        entradaObligatoria && <span class="required">*</span>
      }</label
    >
    <input
      type="text"
      id={entradaId}
      name={nombreEntrada}
      placeholder={placeholderEntrada}
      required={entradaObligatoria}
      aria-required={entradaObligatoria || undefined}
    />
  </div>
</div>
